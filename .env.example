# Availazy environment settings.
# This example contains no credentials. Keep real values only in your ignored .env.
#
# server.py does NOT automatically load .env. From the project directory, run:
# (
#   set -a
#   source ./.env
#   set +a
#   python3 server.py 8780
# )
# The subshell keeps these settings out of your parent Terminal session.

# Local application: 0. Hosted fictional replay only: 1 (binds to 0.0.0.0).
LEDGER_DEMO=0

# Optional Sentry tracing. Empty means OFF.
# A real value also requires the separately installed optional sentry-sdk.
# Never put a real DSN in .env.example or commit .env.
SENTRY_DSN=

# Hosted replay only; ignored by the local application.
# Set local port with: python3 server.py 8780 (default: 8765).
# PORT=10000

# Ollama runs separately at http://127.0.0.1:11434.
# Choose the reader and model in the app; the default model is gemma4:e2b-it-qat.
# No API key is needed for local Ollama. No other environment keys are supported.
